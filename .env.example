# Alby MCP Server Configuration Example
# Copy this file to .env and fill in your values

# ============================================
# Required Configuration
# ============================================

# Nostr Wallet Connect connection string (required for existing NWC tools)
NWC_CONNECTION_STRING=nostr+walletconnect://your-connection-string-here

# Starknet Configuration (required for atomic swaps)
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_8
STARKNET_PRIVATE_KEY=your_starknet_private_key_here
STARKNET_ACCOUNT_ADDRESS=0x1234567890abcdef1234567890abcdef12345678

# Network Configuration
BITCOIN_NETWORK=mainnet  # or testnet for testing

# ============================================
# Optional Configuration
# ============================================

# AtomiqLabs Configuration (optional custom endpoints)
ATOMIQ_INTERMEDIARY_URL=https://your-custom-lp-node.example.com
ATOMIQ_REGISTRY_URL=https://your-custom-registry.example.com
ATOMIQ_TRUSTED_INTERMEDIARY_URL=https://your-trusted-lp.example.com

# Timeout Configuration (milliseconds)
GET_REQUEST_TIMEOUT=10000
POST_REQUEST_TIMEOUT=10000

# Swap Configuration
MAX_PRICING_DIFFERENCE_PPM=20000  # Maximum 2% price difference
DEFAULT_GAS_AMOUNT=1000000000000000000  # 1 STRK for gas drops

# Security Configuration
ENABLE_TESTNET=false  # Set to true for testnet operations

# ============================================
# Server Configuration
# ============================================

# Server mode - STDIO for MCP, HTTP for web interface
MODE=STDIO

# HTTP mode configuration (only if MODE=HTTP)
PORT=3000

# ============================================
# Testnet Configuration (for testing)
# ============================================

# Uncomment and configure for testnet usage
# BITCOIN_NETWORK=testnet
# STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_7
# ENABLE_TESTNET=true

# ============================================
# Development Configuration
# ============================================

# Enable debug logging (optional)
DEBUG=false

# Custom logging level (optional)
LOG_LEVEL=info

# ============================================
# Security Notes
# ============================================

# 1. Never commit .env files to version control
# 2. Use strong, unique private keys
# 3. Regularly rotate keys and connection strings
# 4. Use testnet for development and testing
# 5. Keep RPC URLs and API keys secure
# 6. Monitor for unusual activity

# ============================================
# Getting Started
# ============================================

# 1. Copy this file to .env
# 2. Fill in your NWC connection string
# 3. Configure your Starknet wallet details
# 4. Set the appropriate network (mainnet/testnet)
# 5. Start the server with: npm start
# 6. Test with: npm run inspect